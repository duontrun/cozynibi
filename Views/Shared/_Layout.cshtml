<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CozyNibi Hotel</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/style.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/accommodation.css" />
    <link rel="stylesheet" href="~/css/about.css" />
    <link rel="stylesheet" href="~/css/menu.css" />
    <link rel="stylesheet" href="~/css/tour.css" />
    <link rel="stylesheet" href="~/css/service.css" />
    <link rel="stylesheet" href="~/css/news.css" />
     <link rel="stylesheet" href="~/css/gallery.css" />
</head>
<body>

    <!-- HEADER -->
    <header class="header">
        <div class="container-fluid px-5">
            <div class="row align-items-center">

                <!-- LOGO -->
                <div class="col-lg-2 col-md-3">
                    <div class="logo logo-2-row">
                        <img src="~/images/logo.jpg" alt="CozyNibi Hotel">
                    </div>
                </div>

                <!-- RIGHT -->
                <div class="col-lg-10 col-md-9">

                    <!-- TOP BAR -->
                    <div class="top-bar">
                        <div class="top-right">

                            <div class="search-box">
                                <i class="fa fa-search"></i>
                                <input type="text" placeholder="Search">
                            </div>

                            <div class="language-dropdown">
                                <i class="fa fa-globe"></i>
                                <select>
                                    <option>Viet Nam</option>
                                    <option>English</option>
                                </select>
                            </div>

                            <a href="#" class="btn-book">BOOK A ROOM</a>
                        </div>
                    </div>

                    <!-- MAIN MENU -->
					<nav class="main-nav">
						<ul class="main-menu">
							<li>
								<a asp-controller="Home" asp-action="Index">HOME</a>
							</li>

							<li>
								<a asp-controller="About" asp-action="Index">ABOUT US</a>
							</li>

							<li>
								<a asp-controller="Accommodation" asp-action="Index">ACCOMMODATION</a>
							</li>

							<li>
								<a asp-controller="Menu" asp-action="Index">MENU</a>
							</li>

							<li>
								<a asp-controller="Tour" asp-action="Index">TOUR TRAVEL</a>
							</li>

							<li>
								<a asp-controller="Service" asp-action="Index">SERVICE</a>
							</li>

							<li>
								<a asp-controller="News" asp-action="Index">NEWS</a>
							</li>

							<li>
								<a asp-controller="Gallery" asp-action="Index">GALLERY</a>
							</li>

							<li>
								<a asp-controller="Contact" asp-action="Index">CONTACT</a>
							</li>
						</ul>
					</nav>


                </div>
            </div>
        </div>
    </header>

    <!-- CONTENT -->
    <main class="container-fluid p-0">
        @RenderBody()
    </main>

    @Html.Partial("_Footer")


    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>

</body>
</html>
