@{
	ViewData["Title"] = "Tour Detail";
}

<!-- BANNER -->
<section class="tour-banner"
		 style="background:url('@Url.Content("~/images/banner-travel.jpg")') center/cover no-repeat">
	<div class="tour-banner-overlay">
		<h1>TOUR TRAVEL</h1>
	</div>
</section>

<!-- TITLE -->
<section class="tour-title">
	<h2>
		BAI DINH PAGODA - HOA LU ANCIENT CAPITAL - MUA CAVE - THAI VI TEMPLE
	</h2>
	<p>(TOUR CODE: TNT-PV 01)</p>
</section>

<!-- IMAGES -->
<section class="container tour-images">
	<div class="row">
		<div class="col-md-4">
			<img src="@Url.Content("~/images/travel-3.jpg")">
		</div>
		<div class="col-md-4">
			<img src="@Url.Content("~/images/travel-6.jpg")">
		</div>
		<div class="col-md-4">
			<img src="@Url.Content("~/images/travel-5.jpg")">
		</div>
	</div>
</section>

<!-- SCHEDULE -->
<section class="container tour-schedule">
	<h3>TRIP SCHEDULE</h3>

	<table class="table">
		<tr>
			<td>8:00 AM</td>
			<td>Pick up and depart to Bai Dinh Pagoda</td>
		</tr>
		<tr>
			<td>8:30 AM</td>
			<td>Visit Bai Dinh Pagoda</td>
		</tr>
		<tr>
			<td>10:30 AM</td>
			<td>Leave Bai Dinh Pagoda to Hoa Lu Ancient Capital</td>
		</tr>
		<tr>
			<td>12:00 PM</td>
			<td>Lunch at local restaurant</td>
		</tr>
		<tr>
			<td>15:00 PM</td>
			<td>Climb Mua Cave – 500 steps</td>
		</tr>
		<tr>
			<td>16:00 PM</td>
			<td>Return to hotel</td>
		</tr>
	</table>
</section>

<!-- INFO -->
<section class="container tour-info">
	<div class="row">
		<div class="col-md-4">
			<h4>INCLUSIONS</h4>
			<ul>
				<li>Pick up by air-conditioned car</li>
				<li>English speaking guide</li>
				<li>Entrance fees</li>
			</ul>
		</div>

		<div class="col-md-4">
			<h4>EXCLUSIONS</h4>
			<ul>
				<li>Tax & insurance</li>
				<li>Tips</li>
			</ul>
		</div>

		<div class="col-md-4">
			<h4>PRICE</h4>
			<ul>
				<li>2 persons: 75$/person</li>
				<li>3–4 persons: 66$/person</li>
				<li>5–10 persons: 52$/person</li>
			</ul>
		</div>
	</div>
</section>

<!-- OTHER TOURS -->
<section class="container other-tours">
	<h3>OTHER TOURS</h3>
	<div class="row">
		<div class="col-md-3">
			<img src="@Url.Content("~/images/travel-1.jpg")">
		</div>
		<div class="col-md-3">
			<img src="@Url.Content("~/images/travel-2.jpg")">
		</div>
		<div class="col-md-3">
			<img src="@Url.Content("~/images/travel-3.jpg")">
		</div>
		<div class="col-md-3">
			<img src="@Url.Content("~/images/travel-4.jpg")">
		</div>
	</div>
</section>
