@model List<cozynibi.Models.Menu>

<!-- MENU BANNER -->
<section class="menu-banner">
	<div class="menu-banner-overlay">
		<h1>MENU</h1>
	</div>
</section>

<!-- MENU LIST -->
<section class="menu-section container">
	<div class="menu-grid">

		@foreach (var item in Model)
		{
			<div class="menu-item">
				<img src="~/images/@item.Image" alt="@item.Name">
				<div class="menu-title">@item.Name</div>
				<div class="menu-price">@item.Price VNĐ</div>
			</div>
		}
	</div>

	<!-- PAGINATION -->
	<div class="pagination">
		@if (ViewBag.CurrentPage > 1)
		{
			<a asp-action="Index"
			   asp-route-page="@(ViewBag.CurrentPage - 1)">‹</a>
		}

		@for (int i = 1; i <= ViewBag.TotalPages; i++)
		{
			<a asp-action="Index"
			   asp-route-page="@i"
			   class="@(ViewBag.CurrentPage == i ? "active" : "")">
				@i
			</a>
		}

		@if (ViewBag.CurrentPage < ViewBag.TotalPages)
		{
			<a asp-action="Index"
			   asp-route-page="@(ViewBag.CurrentPage + 1)">›</a>
		}
	</div>
</section>
