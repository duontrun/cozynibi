@model List<cozynibi.Models.About>

<!-- BANNER -->
<section class="about-banner">
	<div class="about-banner-overlay">
		<h1>ABOUT US</h1>
	</div>
</section>

@if (Model != null && Model.Any())
{
	<!-- WELCOME -->
	var welcome = Model.FirstOrDefault(x => x.Position == 0);

	if (welcome != null)
	{
		<section class="about-welcome">
			<div class="container text-center">
				<h5>Welcome to</h5>
				<h2>COZYNIBI HOTEL</h2>
				<p>@welcome.Description</p>
			</div>
		</section>
	}

	<!-- SECTIONS -->
	foreach (var item in Model.Where(x => x.Position > 0))
	{
		<section class="about-section @(item.Position % 2 == 0 ? "reverse" : "")">
			<div class="about-image">
				<img src="~/images/@item.Image"
					 onerror="this.src='/images/no-image.jpg'" />
			</div>
			<div class="about-text">
				<h3>@item.Title</h3>
				<p>@item.Description</p>
			</div>
		</section>
	}
}
